# CONFIGURAZIONE BACKEND (NestJS)

# Connessioni ai DB locali containerizzati
MONGO_URI=mongodb://mongo:27017/codeguardian
REDIS_URL=redis://redis:6379

# Segreti per l'autenticazione
JWT_SECRET=inserisci_un_segreto_per_i_jwt
CREDENTIAL_MASTER_KEY=inserisci_una_chiave_aes_256_per_cifrare_token_github

# Segreto HMAC per la comunicazione sicura Backend <-> Agenti
INTERNAL_SHARED_SECRET=segreto-hmac-condiviso-con-agenti

# Configurazione Mailpit (Sostituto di SES)
SMTP_HOST=mailpit
SMTP_PORT=1025

# Configurazione MinIO (Sostituto di S3)
S3_ENDPOINT=http://minio:9000
S3_KEY=minioadmin
S3_SECRET=minioadmin


# CONFIGURAZIONE AGENTI (Python)

# Puntatore al backend interno (per la comunicazione via HMAC)
BACKEND_BASE_URL=http://backend:3000

# Provider LLM. 
LLM_PROVIDER=managed
LLM_API_KEY=inserisci_la_tua_api_key_qui
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1 # Esempio per Qwen via DashScope

# Path assoluto (interno al container) per la directory dei prompt YAML
PROMPTS_DIR=/app/prompts


# CONFIGURAZIONE FRONTEND (React/Vite)

# Endpoint pubblico del backend esposto da NestJS
VITE_API_BASE_URL=http://localhost:3000/api/v1