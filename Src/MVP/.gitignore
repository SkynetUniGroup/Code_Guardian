# ========================
# Dependencies
# ========================
node_modules/
.pnpm-store/

# ========================
# Build, Logs and Cache
# ========================
dist/
build/                 
coverage/
*.log
npm-debug.log*         
yarn-debug.log*        
yarn-error.log*        
pnpm-debug.log*        

# Development tool caches
*.tsbuildinfo          
.eslintcache          

# ========================
# Environment and Secrets
# ========================
.env
.env.*.local
# Also service copies: .env.before-change, .env.bak, .env.local.
# They contain the same keys as .env and must not be versioned.
.env.*
*.pem
# Make sure .env.example is NEVER ignored
!.env.example

# ========================
# OS and IDE
# ========================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ========================
# pnpm state files
# ========================
.modules.yaml
.package-map.json
.pnpm-workspace-state-v1.json

# ========================
# Python (agents service)
# ========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ========================
# Override previous rules
# ========================
!package.json
!pnpm-lock.yaml