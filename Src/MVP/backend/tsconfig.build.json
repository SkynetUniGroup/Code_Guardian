{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Nome diverso da quello di tsconfig.json (vedi il commento la'): stesso
    // posto, ma i due file compilano insiemi di sorgenti diversi — questo
    // esclude test e spec — e condividere una sola memoria incrementale li
    // farebbe invalidare a vicenda a ogni passaggio.
    "tsBuildInfoFile": "./dist/.tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
