{
  "$schema": "https://biomejs.dev/schemas/1.5.3/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnsafeAny": "error"
      }
    }
  },
  "files": {
    "include": ["**/*.{ts,tsx,js,jsx,json}"],
    "exclude": ["node_modules/**", "dist/**"]
  }
}