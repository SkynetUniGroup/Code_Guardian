# Copy this file to .env at the root of Src/MVP and fill in the real values.
# .env must never be committed.
#
# The names here must match the ones the backend validates at startup
# (backend/src/config/env.validation.ts): a variable with the wrong name
# is not ignored, it fails the bootstrap with a Joi error.

# ─────────────────────────── Backend ───────────────────────────
NODE_ENV=development
PORT=3000

# Origin the frontend calls the API from (CORS).
# With docker-compose the browser only talks to nginx on :5173, which forwards
# /api and /socket.io to the backend: calls are same-origin and this value
# is only needed if you point the frontend directly at the backend.
CORS_ORIGIN=http://localhost:5173

# Tasks a single user may start per calendar month (RF.66)
MONTHLY_TASK_LIMIT=50

# Secrets — generate your own, for example with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse these placeholders for anything real.
JWT_SECRET=7e4642ffa0f13fceb69ce97540af4a5e634e2e32ae686c8d6126edd62c7cc63e
CREDENTIAL_MASTER_KEY=bded451a289797290aba5a47c858a254305ebfc7eea726fb5816f0ba374e608b
INTERNAL_SHARED_SECRET=dbed0dd41a2084a22e1ee0d74e009680d2e794d8d2c0086e9b15ddee9d3e5409

# Anti-replay window (seconds) for HMAC-signed /internal/* requests.
HMAC_WINDOW_S=30

# ──────────────────────────── Agents ────────────────────────────
AGENTS_SERVICE_URL=http://agents:8000
BACKEND_BASE_URL=http://backend:3000
# Global prefix for the backend routes (main.ts: setGlobalPrefix).
# It ends up both in the called URL and in the HMAC-signed message.
BACKEND_API_PREFIX=/api/v1
PROMPTS_DIR=/app/prompts

LLM_PROVIDER=bedrock
LLM_API_KEY=                      # leave empty, not needed
LLM_MODEL_GENERAL=qwen.qwen3-32b-v1:0
LLM_MODEL_SECURITY=qwen.qwen3-coder-30b-a3b-v1:0
AWS_REGION=eu-south-1

AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# ────────────────── Static analysis and code quality ──────────────────
# Semgrep runs as a subprocess inside the agents container and downloads the
# rulesets (p/owasp-top-ten, p/python, ...) on first start: it needs outbound
# network access to semgrep.dev. If the binary is missing or there is no
# network, the scan is skipped and the operation continues with the LLM only
# — it does not fail.
ENABLE_SAST_SEMGREP=true
SEMGREP_TIMEOUT_S=120
SAST_MAX_FINDINGS_LLM=40
SAST_MAX_FILES=200

# SonarQube: optional. When true, if the user has saved a SONARQUBE
# credential from /credentials, the DOCS_* operations enrich the prompt with
# the project's quality metrics (complexity, code smell, hotspot).
# No saved credential, or unreachable instance: the operation still runs,
# without metrics. Requires outbound network access to the SonarQube/
# SonarCloud instance from the agents containers.
ENABLE_SONARQUBE=true
SONAR_CACHE_TTL_S=86400

# ─────────────────────── Database and storage ───────────────────────
# Locally without Docker use localhost; with docker-compose the values are
# already overridden by the compose file with the service hostnames.
#
# Note the two different names: the backend reads MONGODB_URI, the Python
# service reads MONGO_URI (LangGraph checkpointer). They point to the same
# database.
MONGODB_URI=mongodb://localhost:27017/codeguardian
MONGO_URI=mongodb://localhost:27017/codeguardian
REDIS_URL=redis://localhost:6379

# Object storage for exported PDFs (BE-20).
# Locally/docker-compose it points at the compose MinIO, which requires
# path-style addressing. In a real AWS S3 deployment: drop S3_ENDPOINT and
# S3_FORCE_PATH_STYLE, set S3_REGION and real credentials — the same
# @aws-sdk/client-s3 code talks to both.
REPORTS_BUCKET_NAME=code-guardian-reports
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─────────────────────────── Frontend ───────────────────────────
# Leave empty/unset in docker-compose: the bundle uses relative paths
# (/api/v1) and nginx forwards them to the backend. Only needed to point
# the frontend at a backend on a different host during development.
# VITE_API_BASE_URL=http://localhost:3000/api/v1
