# Copia questo file in .env alla radice di Src/MVP e riempi i valori reali.
# .env non va mai committato.
#
# I nomi qui devono combaciare con quelli che il backend valida all'avvio
# (backend/src/config/env.validation.ts): una variabile con il nome sbagliato
# non viene ignorata, fa fallire il bootstrap con un errore Joi.

# ─────────────────────────── Backend ───────────────────────────
NODE_ENV=development
PORT=3000

# Origine da cui il frontend chiama l'API (CORS).
# Con docker-compose il browser parla solo con nginx su :5173, che inoltra
# /api e /socket.io al backend: le chiamate sono same-origin e questo valore
# serve solo se si punta il backend direttamente.
CORS_ORIGIN=http://localhost:5173

# Task che un singolo utente puo' avviare per mese solare (RF.66)
MONTHLY_TASK_LIMIT=50

# Segreti — generane di tuoi, per esempio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Non riusare mai questi placeholder per qualcosa di reale.
JWT_SECRET=7e4642ffa0f13fceb69ce97540af4a5e634e2e32ae686c8d6126edd62c7cc63e
CREDENTIAL_MASTER_KEY=bded451a289797290aba5a47c858a254305ebfc7eea726fb5816f0ba374e608b
INTERNAL_SHARED_SECRET=dbed0dd41a2084a22e1ee0d74e009680d2e794d8d2c0086e9b15ddee9d3e5409

# Finestra anti-replay (secondi) per le richieste /internal/* firmate in HMAC.
HMAC_WINDOW_S=30

# ──────────────────────────── Agents ────────────────────────────
AGENTS_SERVICE_URL=http://agents:8000
BACKEND_BASE_URL=http://backend:3000
# Prefisso globale delle rotte del backend (main.ts: setGlobalPrefix).
# Finisce sia nell'URL chiamato sia nel messaggio firmato in HMAC.
BACKEND_API_PREFIX=/api/v1
PROMPTS_DIR=/app/prompts

LLM_PROVIDER=bedrock
LLM_API_KEY=                      # lascia vuoto, non serve
LLM_MODEL_GENERAL=qwen.qwen3-32b-v1:0
LLM_MODEL_SECURITY=qwen.qwen3-coder-30b-a3b-v1:0
AWS_REGION=eu-south-1

AWS_ACCESS_KEY_ID=your_access_key_id_here                      
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here                     

# ────────────────── Analisi statica e qualita' del codice ──────────────────
# Semgrep gira come sottoprocesso dentro il container degli agenti e scarica i
# ruleset (p/owasp-top-ten, p/python, ...) al primo avvio: serve rete in uscita
# verso semgrep.dev. Se il binario manca o la rete non c'e', la scansione viene
# saltata e l'operazione prosegue col solo LLM — non fallisce.
ENABLE_SAST_SEMGREP=true
SEMGREP_TIMEOUT_S=120
SAST_MAX_FINDINGS_LLM=40
SAST_MAX_FILES=200

# SonarQube: opzionale. Con true, se l'utente ha salvato una credenziale
# SONARQUBE da /credentials, le operazioni DOCS_* arricchiscono il prompt con
# le metriche di qualita' del progetto (complessita', code smell, hotspot).
# Nessuna credenziale salvata, o istanza irraggiungibile: l'operazione gira
# comunque, senza metriche. Serve rete in uscita verso l'istanza SonarQube/
# SonarCloud dai container degli agenti.
ENABLE_SONARQUBE=true
SONAR_CACHE_TTL_S=86400

# ─────────────────────── Database e storage ───────────────────────
# In locale senza Docker usa localhost; con docker-compose i valori sono gia'
# sovrascritti dal file compose con gli hostname dei servizi.
#
# Attenzione ai due nomi diversi: il backend legge MONGODB_URI, il servizio
# Python legge MONGO_URI (checkpointer LangGraph). Puntano allo stesso database.
MONGODB_URI=mongodb://localhost:27017/codeguardian
MONGO_URI=mongodb://localhost:27017/codeguardian
REDIS_URL=redis://localhost:6379

# Object storage per i PDF esportati (BE-20).
# In locale/docker-compose punta al MinIO del compose, che richiede
# l'addressing path-style. In un deploy reale su AWS S3: togliere S3_ENDPOINT e
# S3_FORCE_PATH_STYLE, impostare S3_REGION e credenziali vere — lo stesso
# codice @aws-sdk/client-s3 parla con entrambi.
REPORTS_BUCKET_NAME=code-guardian-reports
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─────────────────────────── Frontend ───────────────────────────
# Lasciare vuoto/non impostato in docker-compose: il bundle usa percorsi
# relativi (/api/v1) e nginx li inoltra al backend. Serve solo per puntare
# il frontend a un backend su un host diverso durante lo sviluppo.
# VITE_API_BASE_URL=http://localhost:3000/api/v1
