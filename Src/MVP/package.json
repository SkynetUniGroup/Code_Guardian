{
  "name": "codeguardian-MVP-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "pnpm format && pnpm lint",
    "build": "pnpm -r run build",
    "test:unit": "pnpm -r run test",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:test": "pnpm --filter backend run test:e2e",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration": "pnpm test:integration:up && pnpm test:integration:test; pnpm test:integration:down",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:cov": "pnpm -r run test:cov"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome format --write"
    ],
    "*.py": [
      "python -m ruff format"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@vitest/coverage-v8": "^4.1.11",
    "lint-staged": "^17.4.1",
    "vitest": "^4.1.11"
  }
}
