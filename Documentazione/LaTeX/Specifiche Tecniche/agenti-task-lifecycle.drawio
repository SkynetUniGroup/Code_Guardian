<mxfile host="app.diagrams.net" agent="Claude Code">
  <diagram name="Ciclo di vita della Task" id="agenti-lifecycle-diagram">
    <mxGraphModel dx="1030" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
